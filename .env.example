# ==========================================================================
# Vantage — Virtualizor Enduser VPS control panel
# Copy this file to .env.local and fill in your own values.
# NEVER commit real credentials. NEVER prefix secrets with NEXT_PUBLIC_.
# ==========================================================================

# --------------------------------------------------------------------------
# Virtualizor connection (server-side only)
# --------------------------------------------------------------------------
# Panel origin including protocol and port, e.g. https://panel.example.com:4083
VIRTUALIZOR_URL=

# Enduser API credentials created in the Virtualizor end-user panel.
VIRTUALIZOR_API_KEY=
VIRTUALIZOR_API_PASS=

# Default/primary VPS ID. Additional instances on the same account are
# discovered automatically; see docs/VIRTUALIZOR.md.
VIRTUALIZOR_VPS_ID=

# TLS verification is always enforced. Install a valid certificate on the
# panel instead of using a self-signed one.

# --------------------------------------------------------------------------
# Virtualizor client tuning (optional)
# --------------------------------------------------------------------------
# Per-request timeout in milliseconds.
VIRTUALIZOR_TIMEOUT_MS=15000
# Longer timeout for long-running operations (reinstall, backup, restore).
VIRTUALIZOR_LONG_TIMEOUT_MS=60000
# Maximum upstream response body size in bytes before the request is aborted.
VIRTUALIZOR_MAX_RESPONSE_BYTES=2097152
# How long (seconds) a capability-detection probe result is cached.
VIRTUALIZOR_CAPABILITY_TTL_S=300

# --------------------------------------------------------------------------
# Dashboard authentication (required in production)
# --------------------------------------------------------------------------
# Shared password required to access the dashboard and the API routes.
DASHBOARD_PASSWORD=
# Random secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=
# Session lifetime in hours (default 12). Bounded to a safe maximum.
AUTH_SESSION_HOURS=12

# --------------------------------------------------------------------------
# Rate limiting (optional)
# --------------------------------------------------------------------------
# Login attempts allowed per window, per client, before lockout.
RATE_LIMIT_LOGIN_MAX=8
# Window length in seconds for the login limiter.
RATE_LIMIT_LOGIN_WINDOW_S=300
# Mutating requests allowed per window, per client.
RATE_LIMIT_MUTATION_MAX=60

# --------------------------------------------------------------------------
# Optional persistence (RESERVED — not read by the current build)
# --------------------------------------------------------------------------
# These variables are placeholders for an opt-in durable backend. The current
# release is fully stateless: rate limiting is in-memory (best effort) and no
# external store is contacted. Setting them has no effect today.
# Redis/KV connection URL (e.g. Vercel KV / Upstash).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --------------------------------------------------------------------------
# Optional notifications (RESERVED — not read by the current build)
# --------------------------------------------------------------------------
# Placeholders for future alert integrations. No webhook is sent today.
# Generic webhook/Discord/Slack incoming webhook URLs.
NOTIFY_WEBHOOK_URL=
NOTIFY_DISCORD_URL=
NOTIFY_SLACK_URL=

# --------------------------------------------------------------------------
# Branding / runtime (optional)
# --------------------------------------------------------------------------
# RESERVED: not read by the current build (product name is fixed to "Vantage").
VANTAGE_APP_NAME=
VANTAGE_LOG_LEVEL=info
